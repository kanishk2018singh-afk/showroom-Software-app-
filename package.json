{
  "name": "showroom-manager-billing",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Showroom Manager — MyBillBook style GST billing & inventory app (Electron Desktop)",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "smoke": "node smoke/run.mjs",
    "verify": "npm run typecheck && npm run smoke",
    "build:single": "vite build --config vite.config.singlefile.ts && node scripts/make-single.mjs",
    "build:preview": "npm run build && node scripts/make-preview.mjs",
    "serve:static": "node scripts/serve.mjs",
    "start": "electron .",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^1.1.7",
    "fake-indexeddb": "^6.2.5",
    "html2canvas-pro": "^1.5.11",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
